<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.10.0</Version></PropertyGroup>
  <!-- Built-in UI languages (Greek, English). More languages = more files in a "locales" folder next to the program. -->
  <ItemGroup><EmbeddedResource Include="Locales\*.json" LogicalName="OpsisNewsCrawler.Locales.%(Filename).json" /></ItemGroup>
</Project>
